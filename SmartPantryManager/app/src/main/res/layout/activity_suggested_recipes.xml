<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/pantry_background">

    <!-- Green heading card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/pantry_green"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/pantry_green_dark"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Button that returns to the pantry screen -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBackToPantry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:text="←  Pantry"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pantry_green_dark"
                app:cornerRadius="14dp" />

            <!-- Orange decorative accent -->
            <View
                android:layout_width="54dp"
                android:layout_height="5dp"
                android:layout_marginBottom="12dp"
                android:background="@color/pantry_orange" />

            <TextView
                android:id="@+id/textSuggestedRecipesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suggested Recipes"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSuggestedRecipesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delicious meals you can make with what is already in your pantry."
                android:textColor="#E8F5EF"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- List/empty-message container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Matching recipes will appear here -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- Shown only when no recipes match -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/pantry_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/pantry_orange"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No recipes yet"
                    android:textColor="@color/pantry_green_dark"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textNoRecipes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="No recipes match your pantry yet. Add more ingredients to discover something delicious."
                    android:textColor="@color/pantry_text_muted"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>